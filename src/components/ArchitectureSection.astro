---
// Architecture deep-dive — based on official tourism sources.
const facts = [
  ['1498', 'નિર્માણારંભ'],
  ['5 માળ', 'પગથિયાં અને ગલારીઓ'],
  ['~75 ફૂટ (~23 મી)', 'અંદાજિત ઊંડાઈ'],
  ['રેતીપથ્થર', 'લાલ-પીળો પથ્થર']
];
const cards = [
  { title: 'પાંચ સ્તરની યોજના', text: 'વાવ ઉપરથી પાણીના સ્તર સુધી પાંચ માળે ઉતરે છે. ચારે બાજુથી પગથિયાં સાથે ઉતરતી ગલારીઓ કેન્દ્રમાં ભેગી થાય છે; તળિયે અષ્ટકોણીય ખુલ્લું કેન્દ્ર આકાશ તરફ ખૂલે છે.' },
  { title: 'ત્રણ પ્રવેશદ્વાર', text: 'વાવને ત્રણ પ્રવેશદ્વાર છે — મુખ્ય પૂર્વ તરફ, બીજા ઉત્તર અને દક્ષિણે. રચના એવી છે કે દિવસના મોટા ભાગે કોઈક દિશાથી છાંયામાં ઉતરી શકાય.' },
  { title: 'કોતરણીનું સંગ્રહાલય', text: 'સ્તંભો, ધરણાં અને કૌંસ (કુટસ) પર આકાશીય નર્તકો (અપ્સરાઓ), સંગીતકારો, હાથી, ફૂલ-પાન અને ભૌમિતિક પટ્ટાઓ કોતરેલાં છે; ઇસ્લામિક ગૂંથણકામવાળી કમાનો હિંદુ-જૈન શિલ્પો સાથે ભળી જાય છે.' }
];
---
<section class="section" id="architecture">
  <div class="shell">
    <span class="eyebrow">સ્થાપત્ય વિશેષ</span>
    <h2 class="section-title">પથ્થરમાં ગોઠવાયેલું એન્જિનિયરિંગ</h2>
    <p>અડાલજની વાવ સોલંકી શૈલીમાં રેતીપથ્થરથી બનેલી છે, પણ તેમાં હિંદુ, જૈન અને ઇસ્લામિક કલા એકસાથે મળે છે — આથી તેને ઈન્ડો-ઇસ્લામિક સ્થાપત્યનું દુર્લભ ઉદાહરણ ગણાય છે. પગથિયાં દ્વારા ભેગું થયેલું વરસાદી પાણી ઊંડે ઠંડું અને છાંયાવાળું રહે છે, જે વર્ષભર ઉપયોગી હતું.</p>
    <div class="arch-facts">
      {
        facts.map((f) => (
          <div class="arch-fact"><b>{f[0]}</b><span>{f[1]}</span></div>
        ))
      }
    </div>
    <div class="grid3">
      {
        cards.map((c) => (
          <article class="card"><h3>{c.title}</h3><p>{c.text}</p></article>
        ))
      }
    </div>
    <p class="small" style="margin-top:16px">ગુજરાતની વાવ (સોપાનવાવ) પરંપરાનો આ શ્રેષ્ઠ નમૂનો છે — જ્યાં પાણી સંગ્રહની એન્જિનિયરિંગ કલા સાથે ભળી જાય છે. સ્થળ-વિશિષ્ટ વિગતો માટે ભારત સરકારના પ્રવાસન પોર્ટલ અને ગુજરાત પ્રવાસનના જાહેર પૃષ્ઠો જુઓ.</p>
  </div>
</section>
