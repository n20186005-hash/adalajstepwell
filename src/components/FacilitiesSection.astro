---
// Facilities — neutral, type-only recommendations (no merchant names).
const facilities = [
  { title: 'શૌચાલય (WC)', text: 'સ્મારક પરિસરમાં મૂળભૂત જાહેર શૌચાલય હોઈ શકે છે; ઉપલબ્ધતા અને સફાઈ સ્થળે બદલાય છે, રજાઓના દિવસોમાં મર્યાદિત રહી શકે છે.' },
  { title: 'પાર્કિંગ', text: 'પ્રવેશદ્વાર નજીક રસ્તા કિનારે/નિયત પાર્કિંગ ઉપલબ્ધ હોઈ શકે છે. તહેવારોના દિવસોમાં જગ્યા મર્યાદિત હોય છે — વહેલા આવવું સલાહભર્યું છે.' },
  { title: 'ભોજન (શાકાહારી)', text: 'અમદાવાદ–ગાંધીનગર માર્ગ પર ગુજરાતી થાળી, ફરસાણ, ચા અને શાકાહારી ભોજનનાં સ્થળો મળે છે. અમે કોઈ ચોક્કસ દુકાનની ભલામણ કરતા નથી; તાજી સ્થાનિક સમીક્ષાઓ તપાસો.' },
  { title: 'રહેઠાણ', text: 'ગાંધીનગર અને અમદાવાદમાં હોટલ/ગેસ્ટહાઉસના વિકલ્પો મળે છે. તહેવારોની મોસમમાં અગાઉથી બુકિંગ કરવું ઉચિત છે.' },
  { title: 'કરિયાણું / સુપરમાર્કેટ', text: 'અડાલજ અને ગાંધીનગરમાં કરિયાણાની દુકાનો અને સુપરમાર્કેટ ઉપલબ્ધ છે — પાણી, નાસ્તો અને રોજિંદી જરૂરિયાતો માટે.' },
  { title: 'ઇંધણ અને ચાર્જિંગ', text: 'મુખ્ય ધોરી માર્ગ પર પેટ્રોલ/ડીઝલ પંપ મળે છે. ઇલેક્ટ્રિક વાહન ચાર્જિંગની ઉપલબ્ધતા બદલાય છે — મુસાફરી પહેલાં ચકાસો.' },
  { title: 'દવાખાનું / ક્લિનિક', text: 'અડાલજમાં ફાર્મસી અને ક્લિનિક મળી શકે છે; કટોકટી માટે ગાંધીનગર/અમદાવાદની હોસ્પિટલો નજીક છે.' },
  { title: 'ATM / રોકડ', text: 'અડાલજ અને ગાંધીનગરમાં ATM ઉપલબ્ધ છે. રોકડનો અનામત વિકલ્પ સાથે રાખવો સલાહભર્યું છે.' }
];
---
<section class="section motif" id="facilities">
  <div class="shell">
    <span class="eyebrow">મુલાકાતી સુવિધાઓ</span>
    <h2 class="section-title">અડાલજ આસપાસ સુવિધાઓ</h2>
    <p>નીચે માત્ર સેવા-પ્રકારોની તટસ્થ માહિતી છે — કોઈ ચોક્કસ વ્યાપારી સંસ્થાની ભલામણ નથી. વ્યવસ્થા સમય સાથે બદલાઈ શકે છે, મુસાફરી પહેલાં સ્થળ પર ચકાસો.</p>
    <div class="fac-grid">
      {
        facilities.map((f) => (
          <article class="fac-card">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <span class="hint">સ્થળ પર ચકાસો</span>
          </article>
        ))
      }
    </div>
    <p class="neutral-note">તટસ્થ નીતિ: આ વેબસાઇટ નફારહિત માહિતી પ્રોજેક્ટ છે અને કોઈ દુકાન, હોટેલ, રેસ્ટોરન્ટ કે સેવાપ્રદાતાની ભલામણ કરતી નથી. ઉપરોક્ત સૂચિ સામાન્ય માહિતી માટે છે; ઉપલબ્ધતા માટે સ્થાનિક સત્તાવાર સ્ત્રોતો — <a class="source-link" href="https://gandhinagar.nic.in/" rel="noopener">ગાંધીનગર જિલ્લા પ્રશાસન</a>, <a class="source-link" href="https://www.gujarattourism.com/" rel="noopener">ગુજરાત પ્રવાસન</a> — તપાસો.</p>
  </div>
</section>
