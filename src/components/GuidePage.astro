---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import { englishGuides } from '../content/english-guides';
import { localizedPath } from '../i18n';
import { SITE_NAME } from '../data/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../lib/schema';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const guide = englishGuides[slug];

if (!guide) {
  Astro.response.status = 404;
}

const path = `/en/${slug}/`;
const pageUrl = guide && Astro.site ? new URL(path, Astro.site).toString() : undefined;
const homeUrl = Astro.site ? new URL('/en/', Astro.site).toString() : undefined;
const title = guide ? `${guide.title} | ${SITE_NAME.en}` : `Page not found | ${SITE_NAME.en}`;
const description = guide?.description ?? 'This English guide page could not be found.';
---
<BaseLayout title={title} description={description} locale="en" path={path} noHreflang>
  <Fragment slot="head">
    {guide && pageUrl && homeUrl && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema(homeUrl, pageUrl, guide.title))}></script>}
    {guide && pageUrl && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema(pageUrl, guide.title, guide.description, 'en'))}></script>}
    {guide && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema(guide.faq))}></script>}
  </Fragment>

  <header class="legal-nav">
    <div class="shell nav">
      <a href={localizedPath('/', 'en')} aria-label={SITE_NAME.en}><img src="/logo.svg" alt={SITE_NAME.en} width="184" height="42" /></a>
      <a href="/en/">Home</a>
      <a href="/en/all-guides/">All guides</a>
      <a href="/en/timings/">Timings</a>
      <a href="/en/entry-fee/">Entry fee</a>
      <a href="/en/transport/">Transport</a>
      <a href="/en/history/">History</a>
      <LocaleSwitcher locale="en" basePath="/" />
    </div>
  </header>

  <main>
    {guide ? (
      <>
        <nav class="shell nav small" aria-label="Guide breadcrumbs" style="padding-top:18px">
          <a href="/en/">English guide</a>
          <span>/</span>
          <span>{guide.title}</span>
        </nav>

        <section class="hero" style="min-height:62vh">
          <img class="hero-bg" src="/images/adalaj-stepwell-guide-1.jpg" alt={guide.title} fetchpriority="high" />
          <div class="shell hero-content">
            <span class="eyebrow" style="color:#f3d6b3">{guide.eyebrow}</span>
            <h1>{guide.title}</h1>
            <p>{guide.intro}</p>
            <div class="facts">
              {guide.facts.map((fact) => (
                <div class="fact">
                  <b>{fact.value}</b>
                  <span>{fact.label}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="section">
          <div class="shell">
            <p class="neutral-note">Last verified for this page: {guide.lastVerified}. When a venue controls its own gate, prayer, ticket or exhibition schedule, treat the official source as the final check before you leave.</p>
            <div class="grid3" style="margin-top:22px">
              <article class="card">
                <h3>What this guide covers</h3>
                <p>{guide.description}</p>
              </article>
              <article class="card">
                <h3>Quick takeaway</h3>
                <p>{guide.facts[0]?.label}: {guide.facts[0]?.value}. Start here if you want a straight answer you can act on before you set out.</p>
              </article>
              <article class="card">
                <h3>Before you go</h3>
                <p>This is an independent travel guide, not the monument or venue operator. Timings, tickets and prayer schedules can change, so always confirm on the official source before you travel.</p>
              </article>
            </div>
          </div>
        </section>

        <section class="section motif">
          <div class="shell">
            {guide.sections.map((section) => (
              <article class="card" style="margin-bottom:18px">
                <h2 class="sub-title" style="margin-top:0">{section.title}</h2>
                {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </section>

        <section class="section faq">
          <div class="shell">
            <span class="eyebrow">FAQ</span>
            <h2 class="section-title">Quick answers</h2>
            {guide.faq.map((item) => (
              <details>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="section motif">
          <div class="shell">
            <span class="eyebrow">Related pages</span>
            <h2 class="section-title">Keep planning</h2>
            <div class="grid3">
              {guide.related.map((item) => (
                <article class="card">
                  <a class="btn secondary" href={item.href}>{item.label}</a>
                </article>
              ))}
            </div>
          </div>
        </section>

        <section class="section">
          <div class="shell">
            <span class="eyebrow">Sources</span>
            <h2 class="section-title">Checked sources</h2>
            <div class="sources">
              {guide.sources.map((source) => (
                <a class="source-item" href={source.href} target="_blank" rel="noopener noreferrer">
                  <span class="source-label">
                    <strong>{source.label}</strong>
                    <span class="small">{source.href}</span>
                  </span>
                  <span class="tag">Source</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    ) : (
      <section class="section">
        <div class="shell">
          <h1>Guide page not found</h1>
          <p>The requested English guide is not available.</p>
          <p><a class="btn" href="/en/">Return to the English homepage</a></p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
