---
import { locales, localeLabel, localizedPath, stripLocale, type Locale } from '../i18n';
interface Props { locale: Locale; basePath?: string; }
const { locale, basePath } = Astro.props;
const base = basePath ?? stripLocale(Astro.url.pathname);
---
<nav class="lang-switch" aria-label="Language">
  {locales.map((l)=>(
    <a href={localizedPath(base,l)} hreflang={l} lang={l} class:list={[{active:l===locale}]} aria-current={l===locale?'page':undefined}>{localeLabel[l]}</a>
  ))}
</nav>
