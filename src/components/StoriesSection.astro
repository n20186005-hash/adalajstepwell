---
// Stories & legends — based on official tourism sources (Incredible India, Gujarat Tourism).
const stories = [
  { kind: 'historical', badge: 'ઐતિહાસિક', title: 'શરૂઆત 1498 — પાણી અને છાંયાની યોજના', text: 'વઘેલા વંશના સરદાર રાણા વીર સિંહે લોકો માટે પાણી અને છાંયો પૂરો પાડવા વાવના નિર્માણની શરૂઆત કરી. વાવ પૂરી થાય તે પહેલાં પ્રદેશ મહમૂદ બેગડાના નિયંત્રણમાં આવ્યો; યુદ્ધમાં રાણા વીર સિંહનું મૃત્યુ થતાં નિર્માણ અધૂરું રહ્યું.' },
  { kind: 'legend', badge: 'દંતકથા', title: 'રુદાબાઈની શરત અને બલિદાન', text: 'પરંપરા અનુસાર રાણા વીર સિંહના મૃત્યુ પછી રાણી રુદાબાઈ સતી થવા માંગતી હતી. બેગડાએ લગ્નનો પ્રસ્તાવ મૂક્યો; રુદાબાઈએ વાવ પૂર્ણ કરાવવાની શરતે સંમતિ આપી. છેલ્લો પગથિયો બેસતાં જ તેમણે દિવંગત પતિ માટે પ્રાર્થના કરી અને પોતાને કૂવામાં સમર્પિત કરી દીધાં — આથી વાવને પ્રેમ અને પ્રતિભાવનું સ્મારક ગણાય છે.' },
  { kind: 'culture', badge: 'સંસ્કૃતિ', title: 'પથ્થરમાં કોતરેલાં પ્રતીકો', text: 'કોતરણીમાં કલ્પવૃક્ષ (ઈચ્છાપૂર્તિનું વૃક્ષ), અમી કુંભોર (અખંડ સમૃદ્ધિનો ઘડો) અને નવગ્રહ (અશુભ ગ્રહોથી રક્ષણ) જેવાં પ્રતીકો મળે છે. હિંદુ દેવી-દેવતાઓ, જૈન તીર્થંકરો અને ઇસ્લામિક ભૌમિતિક પટ્ટાઓ એક જ સ્થળે — સાંસ્કૃતિક સહિષ્ણુતાનું જીવંત ઉદાહરણ.' },
  { kind: 'arch', badge: 'સ્થાપત્ય', title: 'પ્રકાશનું ગણિત', text: 'અષ્ટકોણીય ખુલ્લું કેન્દ્ર આકાશ તરફ ખૂલે છે, જેથી પ્રકાશ અને હવા અંદર પ્રવેશે. રચના એવી છે કે સૂર્યપ્રકાશ મોટે ભાગે બપોરે જ પાણી સુધી પહોંચે; બાકીના સમયે સ્તરો છાંયામાં રહે છે અને અંદર નોંધપાત્ર ઠંડક જળવાઈ રહે છે.' },
  { kind: 'historical', badge: 'સામાજિક ઇતિહાસ', title: 'માર્ગ પરનું વિશ્રામસ્થાન', text: 'વાવ જૂના વેપારી માર્ગ પર હતી. અમદાવાદ અને આસપાસના કસ્બાઓ વચ્ચે આવતા વેપારીઓ, કાફલાઓ અને યાત્રિકો અહીં પાણી, સ્નાન અને આરામ માટે રોકાતા — એટલે વાવ માત્ર પાણીનો ભંડાર નહીં, સામાજિક મિલનસ્થળ પણ હતી.' }
];
---
<section class="section motif" id="stories">
  <div class="shell">
    <span class="eyebrow">વાર્તા અને દંતકથાઓ</span>
    <h2 class="section-title">પથ્થરમાં કોરાયેલી યાદો</h2>
    <div class="stories">
      {
        stories.map((s) => (
          <article class="story">
            <span class={`kind ${s.kind}`}>{s.badge}</span>
            <div><b>{s.title}</b><p>{s.text}</p></div>
          </article>
        ))
      }
    </div>
  </div>
</section>
