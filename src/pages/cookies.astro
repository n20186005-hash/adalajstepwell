---
import BaseLayout from '../layouts/BaseLayout.astro'; const title='કૂકી સેટિંગ્સ | અડાલજની વાવ પ્રવાસ માર્ગદર્શિકા'; const description='આવશ્યક, વિશ્લેષણ, પસંદગી અને માર્કેટિંગ કૂકી માટેની સેટિંગ્સ.';
---
<BaseLayout {title} {description} locale="gu" path="/cookies/" noHreflang><header class="legal-nav"><div class="shell nav"><a href="/"><img src="/logo.svg" alt="અડાલજની વાવ" width="180" /></a><a href="/">મુખ્ય પાનું</a><a href="/privacy/">ગોપનીયતા નીતિ</a><a href="/terms/">સેવાની શરતો</a></div></header><main class="section legal"><div class="shell" style="max-width:860px"><span class="eyebrow">સંમતિ વ્યવસ્થાપન</span><h1 class="section-title">કૂકી સેટિંગ્સ</h1><p><strong>છેલ્લું અપડેટ: સપ્ટેમ્બર 2026</strong></p><p>અમે બ્રાઉઝિંગ અનુભવ સુધારવા માટે કૂકી નો મર્યાદિત ઉપયોગ કરીએ છીએ. નીચે તમારી પસંદગી બદલી શકો છો.</p><div class="card"><div class="cookie-row"><div><b>આવશ્યક કૂકી</b><p class="small">વેબસાઇટના મૂળ કાર્ય માટે જરૂરી; બંધ કરી શકાતી નથી.</p></div><button class="switch on" disabled>હંમેશા ચાલુ</button></div><div class="cookie-row"><div><b>વિશ્લેષણ કૂકી — ગૂગલ ઍનલિટિક્સ</b><p class="small">અનામ/સંક્ષિપ્ત ઉપયોગ ડેટાથી સાઇટ સમજવામાં મદદ કરે છે.</p></div><button id="analytics" class="switch off" type="button">બંધ</button></div><div class="cookie-row"><div><b>પસંદગી કૂકી</b><p class="small">સ્થાનિક બ્રાઉઝર સેટિંગ્સ યાદ રાખવા.</p></div><button id="preferences" class="switch on" type="button">ચાલુ</button></div><div class="cookie-row"><div><b>માર્કેટિંગ કૂકી</b><p class="small">આ પ્રોજેક્ટ વ્યક્તિગત જાહેરાત માટે માર્કેટિંગ ટ્રેકર લોડ કરતું નથી.</p></div><button class="switch off" disabled>બંધ</button></div><div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px"><button id="save" class="btn" type="button">પસંદગીઓ સાચવો</button><button id="reject" class="btn secondary" type="button">બધું નકારો</button></div><p id="status" class="small" aria-live="polite"></p></div></div></main><script is:inline>
const key='adalaj-cookie-preferences';const a=document.getElementById('analytics'),p=document.getElementById('preferences'),s=document.getElementById('status');let state={analytics:false,preferences:true};try{state={...state,...JSON.parse(localStorage.getItem(key)||'{}')}}catch(e){}function paint(){a.textContent=state.analytics?'ચાલુ':'બંધ';a.className='switch '+(state.analytics?'on':'off');p.textContent=state.preferences?'ચાલુ':'બંધ';p.className='switch '+(state.preferences?'on':'off')}paint();a.onclick=()=>{state.analytics=!state.analytics;paint()};p.onclick=()=>{state.preferences=!state.preferences;paint()};document.getElementById('save').onclick=()=>{localStorage.setItem(key,JSON.stringify(state));s.textContent='પસંદગીઓ સાચવાઈ. વિશ્લેષણ સેટિંગ લાગુ કરવા પાનું ફરી લોડ કરો.'};document.getElementById('reject').onclick=()=>{state={analytics:false,preferences:false};localStorage.setItem(key,JSON.stringify(state));paint();s.textContent='વૈકલ્પિક કૂકી નકારવામાં આવ્યા.'};
</script></BaseLayout>
