---
import GuidePage from '../../components/GuidePage.astro';
import { englishGuides } from '../../content/english-guides';

const { guide } = Astro.params;

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(englishGuides).map((guide) => ({
    params: { guide },
  }));
}
---
<GuidePage slug={guide ?? ''} />
