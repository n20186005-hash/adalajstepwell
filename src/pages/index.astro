import BaseLayout from '../layouts/BaseLayout.astro';
import WeatherSection from '../components/WeatherSection.astro';
import StoriesSection from '../components/StoriesSection.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import FacilitiesSection from '../components/FacilitiesSection.astro';
import EtiquetteSection from '../components/EtiquetteSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
const title='અડાલજની વાવ (અડાલજ, ગુજરાત) — પ્રવાસ માર્ગદર્શિકા અને સ્થળ';
const description='અડાલજની વાવ (રુદાબાઈની વાવ), અડાલજ, ગુજરાત — ઇતિહાસ, સ્થાપત્ય, મુલાકાત સમય, પહોંચ, પાર્કિંગ, સુવિધાઓ અને અક્ષરધામ/ત્રિમંદિર નજીક. પ્રવાસ માર્ગદર્શિકા.';
const site=Astro.site;
const pageUrl=site?new URL('/',site).toString():undefined;
const heroImage=site?new URL('/images/adalaj-stepwell-hero.jpg',site).toString():undefined;
const attraction={
 '@context':'https://schema.org','@type':['TouristAttraction','LocalBusiness'],name:'અડાલજની વાવ',alternateName:['Adalaj Stepwell','Adalaj ni Vav','Rudabai Stepwell'],description,
 ...(pageUrl?{url:pageUrl,'@id':pageUrl+'#attraction'}:{}),
 ...(heroImage?{image:[heroImage]}:{}),
 'hasMap':'https://maps.app.goo.gl/L6jtyGBiHo9eYhdN9',
 sameAs:['https://maps.app.goo.gl/L6jtyGBiHo9eYhdN9','https://www.incredibleindia.gov.in/en/gujarat/gandhinagar/adalaj-stepwell','https://www.gujarattourism.com/'],
 address:{'@type':'PostalAddress',streetAddress:'Adalaj Rd',addressLocality:'Adalaj',addressRegion:'Gujarat',postalCode:'382421',addressCountry:'IN'},
 geo:{'@type':'GeoCoordinates',latitude:23.1668,longitude:72.5801},
 openingHoursSpecification:{'@type':'OpeningHoursSpecification',dayOfWeek:['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],opens:'08:00',closes:'18:00'},
 aggregateRating:{'@type':'AggregateRating',ratingValue:'4.5',reviewCount:'31069',bestRating:'5'}
};
const breadcrumb=pageUrl?{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
 {'@type':'ListItem',position:1,name:'અડાલજની વાવ',item:pageUrl},
 {'@type':'ListItem',position:2,name:'અડાલજ',item:pageUrl},
 {'@type':'ListItem',position:3,name:'ગાંધીનગર જિલ્લો',item:pageUrl},
 {'@type':'ListItem',position:4,name:'ગુજરાત',item:pageUrl},
 {'@type':'ListItem',position:5,name:'ભારત',item:pageUrl}
]}:undefined;
const faq={ '@context':'https://schema.org','@type':'FAQPage',mainEntity:[
 {'@type':'Question',name:'અડાલજની વાવ જોવા માટે કેટલો સમય રાખવો?',acceptedAnswer:{'@type':'Answer',text:'મોટાભાગના મુલાકાતીઓ માટે 60 થી 90 મિનિટ પૂરતી છે. કોતરણી, પ્રકાશ અને ફોટોગ્રાફી માટે વધુ સમય રાખી શકાય.'}},
 {'@type':'Question',name:'અડાલજની વાવ માટે પ્રવેશ ફી છે?',acceptedAnswer:{'@type':'Answer',text:'પ્રવેશ નીતિ બદલાઈ શકે છે. મુસાફરી પહેલાં Archaeological Survey of India અથવા સ્થાનિક સત્તાવાર સ્ત્રોતથી હાલની ફી અને નિયમો ચકાસો.'}},
 {'@type':'Question',name:'કયો સમય શ્રેષ્ઠ છે?',acceptedAnswer:{'@type':'Answer',text:'ઓક્ટોબરથી માર્ચનું હવામાન વધુ આરામદાયક હોય છે. વહેલી સવાર અથવા સાંજ પહેલાંનો સમય કોતરણી પર નરમ પ્રકાશ માટે અનુકૂળ છે.'}},
 {'@type':'Question',name:'અમદાવાદથી કેવી રીતે પહોંચવું?',acceptedAnswer:{'@type':'Answer',text:'અડાલજ અમદાવાદ અને ગાંધીનગર વચ્ચે આવેલું છે. ટેક્સી, કાર અથવા બસ દ્વારા રોડ માર્ગે પહોંચી શકાય છે; નજીકના મુખ્ય રેલવે કેન્દ્રો અમદાવાદ અને ગાંધીનગર છે.'}},
 {'@type':'Question',name:'અડાલજમાં શું સુવિધાઓ મળે છે?',acceptedAnswer:{'@type':'Answer',text:'પાર્કિંગ, શૌચાલય, શાકાહારી ભોજન, કરિયાણું, ઇંધણ, ફાર્મસી અને ATM નજીકમાં મળી શકે છે. ચોક્કસ વ્યવસ્થા સ્થળ પર ચકાસો; અમે કોઈ વ્યાપારી સંસ્થાની ભલામણ કરતા નથી.'}},
 {'@type':'Question',name:'અડાલજની વાવ સાથે કઈ દંતકથા જોડાયેલી છે?',acceptedAnswer:{'@type':'Answer',text:'સૌથી પ્રચલિત દંતકથા રાણી રુદાબાઈની છે — વાવ પૂર્ણ થતાં તેમણે દિવંગત પતિ માટે પ્રાર્થના કરી અને કૂવામાં સમર્પિત થયાં; આથી વાવને પ્રેમ અને પ્રતિભાવનું સ્મારક કહેવાય છે.'}}
]};
const photos=[
 ['https://upload.wikimedia.org/wikipedia/commons/2/23/Adalaj_Stepwell_%28Rudabai_Stepwell%29.jpg','અડાલજની વાવના સ્તંભો અને ગલારીઓ'],
 ['https://upload.wikimedia.org/wikipedia/commons/0/09/Steps_of_Adalaj_Stepwell.jpg','વાવના બહુસ્તરીય આંતરિક ભાગ'],
 ['https://upload.wikimedia.org/wikipedia/commons/e/e7/0082423_Rudabai_Step_Well%2C_Adalaj_Gujarat_045.jpg','પથ્થરની સુક્ષ્મ કોતરણી']
];
---
<BaseLayout {title} {description} image="/images/adalaj-stepwell-hero.jpg">
<Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(attraction)}></script>{breadcrumb && <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}></script>}<script type="application/ld+json" set:html={JSON.stringify(faq)}></script></Fragment>
<header class="legal-nav"><div class="shell nav"><a href="/" aria-label="મુખ્ય પાનું"><img src="/logo.svg" alt="અડાલજની વાવ માર્ગદર્શિકા" width="184" height="42" /></a><a href="#history">ઇતિહાસ</a><a href="#stories">ગાથાઓ</a><a href="#architecture">સ્થાપત્ય</a><a href="#visit">મુલાકાત</a><a href="#weather">હવામાન</a><a href="#reach">પ્રવાસ</a><a href="#facilities">સુવિધાઓ</a><a href="#nearby">આસપાસ</a><a href="#faq">પ્રશ્નોત્તરી</a><a href="#sources">સ્ત્રોતો</a></div></header>
<main>
<section class="hero">
<img class="hero-bg" src={photos[0][0]} alt={photos[0][1]} fetchpriority="high" />
<div class="shell hero-content"><span class="eyebrow" style="color:#f3d6b3">અડાલજ · ગાંધીનગર જિલ્લો · ગુજરાત · ભારત</span><h1>અડાલજની વાવ (અડાલજ, ગુજરાત)</h1><p>અડાલજની વાવ, જે રુદાબાઈની વાવ તરીકે વ્યાપકપણે ઓળખાય છે, તે અડાલજ, ગાંધીનગર જિલ્લો, ગુજરાત, ભારતમાં આવેલું 15મી સદીના અંતનું સ્મારક છે — જ્યાં પાણી સંગ્રહની બુદ્ધિ, આરામદાયક છાંયો અને હિંદુ–જૈન–ઇસ્લામિક કોતરણી એક જ સ્થાપત્યમાં મળે છે.</p><div class="facts"><div class="fact"><b>15મી સદી</b><span>રુદાબાઈની વાવ</span></div><div class="fact"><b>5 સ્તર</b><span>ભૂગર્ભ ગલારીઓ</span></div><div class="fact"><b>08:00–18:00</b><span>મુસાફરી પહેલાં ચકાસો</span></div><div class="fact"><b>4.5 ★</b><span>31,069 ગૂગલ સમીક્ષાઓ*</span></div></div></div>
</section>
<section class="section" id="history"><div class="shell grid2"><div><span class="eyebrow">સ્થાપત્ય અને વારસો</span><h2 class="section-title">પ્રકાશ, છાંયો અને પથ્થરનું ઊભું શહેર</h2><p>અડાલજની વાવ, જેને રુદાબાઈની વાવ પણ કહેવામાં આવે છે, અડાલજ ગામમાં આવેલી પાંચ માળની ઐતિહાસિક સોપાનવાવ છે. જિલ્લા અને રાષ્ટ્રીય પ્રવાસન સ્ત્રોતો તેને 15મી સદીના અંતની રચના તરીકે દર્શાવે છે અને તેની શિલ્પકામવાળી સ્તંભમાળા, અષ્ટકોણીય ખુલ્લું કેન્દ્ર અને પાણી સુધી ઉતરતા સ્તરોને વિશેષતા ગણાવે છે.</p><p>વાવ માત્ર પાણી મેળવવાનું સાધન નહોતી; વેપારીઓ, યાત્રિકો અને સ્થાનિક લોકો માટે આરામ અને સામાજિક મેળાવડાનું સ્થળ પણ હતી. કોતરણીમાં ફૂલપાન, જ્યોમેટ્રિક પેટર્ન, દૈવી આકૃતિઓ અને રોજિંદા જીવનના દૃશ્યો મળે છે. અડાલજની વાવની મુલાકાતે જનારાઓ નજીકનાં ઐતિહાસિક સીમાચિહ્નો — ગાંધીનગરનું અક્ષરધામ અને અડાલજનું ત્રિમંદિર — પણ સરળતાથી જોઈ શકે છે.</p><p><a class="source-link" href="https://www.incredibleindia.gov.in/en/gujarat/gandhinagar/adalaj-stepwell" rel="noopener">ભારત સરકારનું પ્રવાસન પોર્ટલ</a> · <a class="source-link" href="https://gandhinagar.nic.in/" rel="noopener">ગાંધીનગર જિલ્લા પ્રશાસન</a> · <a class="source-link" href="https://www.gujarattourism.com/" rel="noopener">ગુજરાત પ્રવાસન</a></p></div><div class="photo-frame stone-border"><img class="photo" src={photos[1][0]} alt={photos[1][1]} loading="lazy" /></div></div></section>
<StoriesSection />
<ArchitectureSection />
<section class="section motif" id="visit"><div class="shell"><span class="eyebrow">મુલાકાતની યોજના</span><h2 class="section-title">જતાં પહેલાં જાણવું જરૂરી</h2><div class="grid3"><article class="card"><h3>ટિકિટ / ખર્ચ</h3><p>પ્રવેશ ફી અને ફોટોગ્રાફી સંબંધિત નિયમો બદલાઈ શકે છે. મુલાકાત પહેલાં ASI અથવા સ્થાનિક સત્તાવાર સૂચના ચકાસો. માર્ગદર્શક/પરિવહનનો ખર્ચ અલગ હોઈ શકે.</p></article><article class="card"><h3>શ્રેષ્ઠ સમય</h3><p>ઓક્ટોબરથી માર્ચ વધુ આરામદાયક. નરમ પ્રકાશ માટે વહેલી સવાર અથવા સાંજ પહેલાં આવવું સારું. ઉનાળામાં બપોરનો તાપ ટાળો.</p></article><article class="card"><h3>સૂચિત સમય</h3><p>સામાન્ય મુલાકાત માટે 60–90 મિનિટ. કોતરણી, ફોટોગ્રાફી અને શાંતિથી દરેક સ્તર જોવું હોય તો 2 કલાક સુધી રાખો.</p></article><article class="card"><h3>પાર્કિંગ</h3><p>સ્થળ આસપાસ રોડ આધારિત પહોંચ ઉપલબ્ધ છે. પાર્કિંગ વ્યવસ્થા અને વાહન ફી સ્થળ પર બદલાઈ શકે; ભીડના દિવસોમાં વહેલા આવવું વધુ સરળ રહે છે.</p></article><article class="card"><h3>પહેરવેશ અને સલામતી</h3><p>પથ્થરના પગથિયાં અને છાયાવાળા ભાગો માટે સારી ગ્રિપવાળા શૂઝ પહેરો. ઐતિહાસિક કોતરણીને સ્પર્શ/ખરોચ ન કરો અને સીમિત વિસ્તારોના નિર્દેશો માનશો.</p></article><article class="card"><h3>સરનામું</h3><p>અડાલજ રોડ, અડાલજ, ગુજરાત 382421, ભારત<br/>પ્લસ કોડ: 5H8J+P2</p><a class="btn secondary" href="https://maps.app.goo.gl/L6jtyGBiHo9eYhdN9" rel="noopener">નકશો ખોલો</a></article></div></div></section>
<WeatherSection />
<section class="section" id="reach"><div class="shell grid2"><div><span class="eyebrow">વિગતવાર પરિવહન</span><h2 class="section-title">અમદાવાદ અને ગાંધીનગર વચ્ચે સરળ રોડ પહોંચ</h2><div class="card"><h3>હવાઈ માર્ગ</h3><p>સૌથી નજીકનું મોટું એરપોર્ટ સરદાર વલ્લભભાઈ પટેલ ઇન્ટરનેશનલ એરપોર્ટ, અમદાવાદ છે. ત્યાંથી ટેક્સી/કાર દ્વારા અડાલજ પહોંચી શકાય.</p><h3>રેલ માર્ગ</h3><p>ગાંધીનગર કેપિટલ અને અમદાવાદ જંક્શન બંને ઉપયોગી મુખ્ય સ્ટેશનો છે. આગળનો ભાગ રોડ દ્વારા કરવો પડે છે.</p><h3>રોડ માર્ગ</h3><p>અડાલજ ગાંધીનગર–અમદાવાદ શહેરી પટ્ટા પાસે છે. કેબ, ખાનગી કાર અને સ્થાનિક બસ રૂટ ઉપલબ્ધ હોઈ શકે છે. ટ્રાફિક માટે વધારાનો સમય રાખો.</p></div></div><div class="map"><iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6524.238087457539!2d72.57751457713438!3d23.16681057907292!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x395c29dab0c5bf89%3A0xdb1dddc4bdbd398f!2sThe%20Adalaj%20Stepwell!5e1!3m2!1szh-CN!2s!4v1788188087408!5m2!1szh-CN!2s" width="100%" height="450" style="border:0;" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin" title="અડાલજની વાવ નકશો"></iframe><p class="small" style="margin-top:12px">અધિકૃત માહિતી: <a class="source-link" href="https://www.incredibleindia.gov.in/en/gujarat/gandhinagar/adalaj-stepwell" target="_blank" rel="noopener noreferrer">ભારત સરકાર પ્રવાસન પોર્ટલ</a> · <a class="source-link" href="https://www.gujarattourism.com/" target="_blank" rel="noopener noreferrer">ગુજરાત પ્રવાસન</a></p></div></div></section>
