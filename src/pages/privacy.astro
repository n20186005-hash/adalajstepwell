---
import BaseLayout from '../layouts/BaseLayout.astro';
const title='ગોપનીયતા નીતિ | અડાલજની વાવ પ્રવાસ માર્ગદર્શિકા'; const description='અડાલજની વાવ પ્રવાસ માર્ગદર્શિકાની ગોપનીયતા નીતિ.';
---
<BaseLayout {title} {description} locale="gu" path="/privacy/" noHreflang><header class="legal-nav"><div class="shell nav"><a href="/"><img src="/logo.svg" alt="અડાલજની વાવ" width="180" /></a><a href="/">મુખ્ય પાનું</a><a href="/terms/">સેવાની શરતો</a><a href="/cookies/">કૂકી સેટિંગ્સ</a></div></header><main class="section legal"><div class="shell" style="max-width:860px"><span class="eyebrow">કાનૂની માહિતી</span><h1 class="section-title">ગોપનીયતા નીતિ</h1><p><strong>છેલ્લું અપડેટ: સપ્ટેમ્બર 2026</strong></p><h2>અમે કઈ માહિતી એકત્ર કરીએ છીએ</h2><p>અમે સેવા આપવા માટે જરૂરી ન્યૂનતમ ડેટા જ એકત્ર કરવાનો પ્રયત્ન કરીએ છીએ. તેમાં IP સરનામું, બ્રાઉઝર પ્રકાર, જોવામાં આવેલા પૃષ્ઠો, કૂકી/સમાન ટેક્નોલોજી અને તમે સંપર્ક દ્વારા સ્વૈચ્છિક રીતે આપેલી માહિતી સામેલ હોઈ શકે છે.</p><h2>માહિતીનો ઉપયોગ</h2><ul><li>વેબસાઇટની સામગ્રી અને અનુભવ સુધારવા</li><li>ટ્રાફિક અને ઉપયોગના પેટર્ન સમજવા</li><li>વિનંતીનો જવાબ આપવા</li><li>લાગુ કાયદાકીય ફરજોનું પાલન કરવા</li></ul><h2>ત્રીજા પક્ષની સેવાઓ</h2><p>વેબસાઇટ ગૂગલ મેપ્સ (નકશો/સ્થાન), ગૂગલ ઍનલિટિક્સ (ફક્ત વિશ્લેષણ કૂકી માટે સંમતિ આપ્યા પછી) અને વિકિમીડિયા કોમન્સ જેવી મીડિયા સ્ત્રોત સેવાઓનો સંદર્ભ લઈ શકે છે. દરેક સેવાની પોતાની ગોપનીયતા નીતિ હોય છે.</p><h2>તમારા અધિકારો</h2><p>લાગુ GDPR અને સંબંધિત કાયદા મુજબ તમને વ્યક્તિગત ડેટા ઍક્સેસ, સુધારો/કાઢી નાખવાની વિનંતી, પ્રક્રિયાનો વિરોધ અને યોગ્ય નિયામક સત્તાને ફરિયાદ કરવાનો અધિકાર હોઈ શકે છે.</p><h2>ડેટા ન્યૂનતમકરણ</h2><p>અમે ખાતું, લૉગિન, ડેટાબેઝ અથવા CMS ચલાવતા નથી. આવશ્યક ન હોય ત્યાં વ્યક્તિગત માહિતી માંગવામાં આવતી નથી.</p></div></main></BaseLayout>
